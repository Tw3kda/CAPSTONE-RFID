# Only environment file: copy to .env at repository root.
APP_NAME=thesora
# Generate a different, random password before production deployment.
POSTGRES_DB=thesora
POSTGRES_USER=thesora
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate independent random values; do not rotate DATA_ENCRYPTION_KEY without migrating data.
# AUTH_SIGNING_KEY: at least 32 random characters. DATA_ENCRYPTION_KEY: Fernet key.
AUTH_SIGNING_KEY=
DATA_ENCRYPTION_KEY=
# Suspend ordinary deletion when an institutional instruction/legal hold applies.
RETENTION_HOLD=false

# Local development only. PostgreSQL is never published on the host.
DEV_API_PORT=8001
DEV_API_PROXY_TARGET=http://127.0.0.1:8001
VITE_DEV_PORT=5173

# Public build-time configuration; never put credentials in VITE_* variables.
VITE_API_BASE_URL=/api
